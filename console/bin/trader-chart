#!/usr/bin/env python3
"""trader-chart — the agent's hands on the live Vela chart.

The chart runs in a browser tab; this talks to the console's chart bridge (backend/chart_bridge.py),
which relays the request to that tab and brings the answer back. So the agent can read what the chart
is showing and put something on it without any UI of its own — the operator types into Hermes's own
composer, not a second one.

    trader-chart state                     what the chart shows: symbol, timeframe, price, natives, bars
    trader-chart shot [--out FILE]         capture the chart now and save the PNG (for vision)
    trader-chart apply FILE|-              run Pine over the chart's bars and paint a matching native
    trader-chart add NATIVE                add one of Vela's native indicators
    trader-chart market SYMBOL TIMEFRAME   switch the chart's market
    trader-chart wait ID                   wait for one earlier command's outcome
    trader-chart edge ask "gapFill WHERE dayOfWeek = Tue" --symbol BTCUSDT
                                           Edge Stats: P(outcome | conditions) with N and a 95% interval
                                           (also: edge status | presets | fields | report | session | show | setup)

Exit codes: 0 = it worked · 1 = the chart refused or failed · 2 = no chart is open right now.
`--json` prints the raw payload instead of prose.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("LUXALGO_CONSOLE", "http://127.0.0.1:8787").rstrip("/")
TIMEOUT = float(os.environ.get("LUXALGO_CHART_TIMEOUT", "45"))
INLINE_WAIT = float(os.environ.get("LUXALGO_CHART_INLINE_WAIT", "8"))
POLL = 1.0


def _console_token() -> str:
    """The console mints a token beside its runtime state and requires it on POSTs. Read it here so
    the CLI keeps working; an absent file means the console has never started on this machine."""
    path = os.environ.get("TRADER_CONSOLE_TOKEN_FILE") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "traders-agent", "console.token"
    )
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""


# Loopback calls skip any http_proxy in the environment: it would be sent the console token and every Pine script.
_LOCAL = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def _request(path: str, payload: dict | None = None) -> dict:
    url = BASE + path
    data = json.dumps(payload).encode() if payload is not None else None
    headers = {"content-type": "application/json"} if data else {}
    token = _console_token()
    if token:
        headers["X-Trader-Token"] = token
    req = urllib.request.Request(
        url, data=data,
        headers=headers,
        method="POST" if data else "GET")
    try:
        with _LOCAL.open(req, timeout=TIMEOUT if path.startswith("/api/edgestats") else 30) as res:
            body = json.loads(res.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        # urllib raises for every 4xx/5xx — and HTTPError is a URLError, so without this branch a console
        # that answered "401 no token" or "400 unknown outcome 'gapFil'" read as "cannot reach the console".
        try:
            body = json.loads(exc.read().decode("utf-8"))
        except (ValueError, OSError):
            die(f"the console answered HTTP {exc.code}", 1)
        message = f"console error: {body.get('error') or body}"
        detail = body.get("detail") if isinstance(body.get("detail"), dict) else {}
        inner = detail.get("detail") if isinstance(detail.get("detail"), dict) else {}
        if inner.get("position") is not None:
            message += f" (at character {inner['position']})"
        if detail.get("hint"):
            message += f" — {detail['hint']}"
        die(message, 1)
    except urllib.error.URLError as exc:
        die(f"cannot reach the console at {BASE} ({exc.reason}) — is the console running? (console/start.sh)", 2)
    except (TimeoutError, OSError) as exc:                 # a read that timed out is not a URLError on py3.13
        die(f"the console accepted the connection but did not answer in time ({exc}) — it may be wedged or mid-restart", 2)
    except ValueError as exc:
        die(f"the console sent something unreadable: {exc}", 1)
    if not body.get("ok", False):
        die(f"console error: {body.get('error') or body}", 1)
    return body.get("data") or {}


def get(path: str) -> dict:
    return _request(path)


def post(path: str, payload: dict) -> dict:
    return _request(path, payload)


def _read_file(path: str) -> str:
    """A Pine file, or one sentence and exit 2 (the documented "bad input") instead of a traceback."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError) as exc:
        die(f"cannot read {path}: {exc}", 2)


def die(message: str, code: int) -> None:
    print(f"trader-chart: {message}", file=sys.stderr)
    raise SystemExit(code)


def out(args) -> None:
    """Print either the raw payload or nothing (the caller prints the prose)."""
    if getattr(args, "json", False):
        print(json.dumps(getattr(args, "_payload", {}), indent=2, ensure_ascii=False))


def chart_state(args) -> dict:
    state = get("/api/chart/state")
    args._payload = state
    return state


def require_open(args) -> dict:
    state = chart_state(args)
    if not state.get("open"):
        die(state.get("reason") or "no chart is open", 2)
    return state


def wait(command_id: int, timeout: float = TIMEOUT) -> dict:
    deadline = time.time() + timeout
    while time.time() < deadline:
        result = get(f"/api/chart/result?id={command_id}")
        if not result.get("pending"):
            return result
        time.sleep(POLL)
    die(f"the chart did not answer command {command_id} within {timeout:.0f}s "
        f"(is the chart page still open?)", 1)


def send(args, command: dict) -> dict:
    require_open(args)
    # The console holds the request open (`wait`): with a view on the push channel the result comes
    # back in the same round trip — tens of milliseconds instead of waiting for the page's poll tick.
    queued = post("/api/chart/command", {**command, "wait": INLINE_WAIT})
    if not queued.get("pushed"):
        die("no chart view is attached — open the console (the sidebar row, or the browser tab) and "
            "retry. The command was queued but nothing is listening for it.", 2)
    result = queued.get("result")
    if result is None:
        # The view took longer than our window. Before waiting the full timeout, check that one is
        # still attached at all — a view that died mid-command should fail fast and say so.
        try:
            live = get("/api/chart/stream/status")
        except SystemExit:
            live = {}
        if live and not live.get("views"):
            die(f"the chart view disconnected while command {queued['command']['id']} was in flight "
                f"— open the console again and retry", 1)
        result = wait(int(queued["command"]["id"]))   # slow path: the view is just slow
    args._payload = result
    return result


def error_line(result: dict) -> str:
    """One line for a structured failure: `CODE[feature/kind]: message (hint)`.

    Mirrors the page's contract (console/frontend/pinets-runner.js): a stable code, an optional
    feature/kind, a line number when the engine quoted one, and a hint that says what to do next.
    """
    err = result.get("error") if isinstance(result, dict) else None
    if not isinstance(err, dict):
        return ""
    bits = [str(err.get("code") or "UNKNOWN")]
    if err.get("feature") or err.get("kind"):
        bits.append(str(err.get("feature") or err.get("kind")))
    head = bits[0] + ("[" + "/".join(bits[1:]) + "]" if len(bits) > 1 else "")
    line = f" (line {err['line']})" if err.get("line") else ""
    tail = f" — {err['hint']}" if err.get("hint") else ""
    return f"  {head}{line}: {err.get('message')}{tail}"


def ok_code(result: dict) -> int:
    """Exit code for one command: 0 when something landed on the chart — or when a strategy() run
    produced only metrics (`result: 'metrics'`, the same different-kind-of-success the MCP layer
    prints ◆ for) — else 1. Round 6: the CLI disagreed with the MCP about this case (exit 1 for a
    run the MCP calls success), so a shell checking codes saw a failure the tools did not."""
    return 0 if (result.get("ok") or result.get("result") == "metrics") else 1


def cmd_caps(args) -> int:
    """What the attached page can actually execute, as published in its own heartbeat."""
    state = require_open(args)
    actions = state.get("actions") or []
    if args.json:
        print(json.dumps({"actions": sorted(actions) if actions else [],
                          "reported_age_s": state.get("age_s")}, indent=2, ensure_ascii=False))
        return 0 if actions else 1
    if not actions:
        print("the page has not published its action list — it is running an older console build, "
              "or no page is attached. The server will fall back to its built-in list.")
        return 1
    print("page can execute: " + ", ".join(sorted(actions)))
    print(f"  reported {state.get('age_s')}s ago · {state.get('symbol')} {state.get('timeframe')}")
    return 0


def study_label(row: dict) -> str:
    """`EMA (study/native/cell)` — one study, however many readers can see it."""
    sources = row.get("sources") or [row.get("source") or "?"]
    return f"{row.get('name', '')} ({'/'.join(str(s) for s in sources)})"


def cmd_state(args) -> int:
    state = require_open(args)
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
        return 0
    last = state.get("last")
    print(f"chart: {state.get('symbol')} {state.get('timeframe')} · "
          f"last {last:,.2f}" if isinstance(last, (int, float)) else
          f"chart: {state.get('symbol')} {state.get('timeframe')} · last unknown")
    print(f"  painted natives: {', '.join(state.get('natives') or []) or 'none'}")
    studies = [s for s in (state.get("studies") or []) if isinstance(s, dict)]
    print("  on the chart: " + (", ".join(study_label(s) for s in studies) or "nothing"))
    print(f"  series {state.get('series')} · drawings {state.get('drawings')} · bars {state.get('bars')}")
    print(f"  reported {state.get('age_s')}s ago"
          + (f" · picture on the heartbeat: {state['shot']}"
             if state.get("shot") else " · no picture on the heartbeat (ask for one with `shot`)"))
    return 0


def cmd_shot(args) -> int:
    result = send(args, {"action": "shot"})
    if not result.get("ok") or not result.get("shot"):
        die(f"no picture: {result.get('detail') or 'unknown reason'}", 1)
    dest = args.out or f"/tmp/chart-{int(time.time())}.png"
    shutil.copy(result["shot"], dest)
    if args.json:
        print(json.dumps({**result, "copied_to": dest}, indent=2, ensure_ascii=False))
    else:
        print(dest)
    return 0


def parse_inputs(pairs) -> dict | None:
    """`--input Length=50 --input "Show upper band=false"` -> {"Length": 50, "Show upper band": False}.

    A value that is valid JSON (50, 2.5, true, null, "text") is read as JSON; anything else is text, so
    `--input "MA type=EMA"` and `--input "Basis colour=#ff8800"` work without quoting. The page checks every
    label against the script and answers with the labels it does have.
    """
    if not pairs:
        return None
    out: dict = {}
    for item in pairs:
        name, sep, raw = item.partition("=")
        if not sep or not name.strip():
            die(f"--input wants NAME=VALUE, got {item!r}", 2)
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        if isinstance(value, (dict, list)):
            die(f"--input {name.strip()!r}: a value is a number, true/false, text or null", 2)
        out[name.strip()] = value
    return out


def cmd_draw(args) -> int:
    """Run a Library script and paint what it built (boxes/lines/labels) on our own overlay."""
    import sys as _sys
    pine = _sys.stdin.read() if args.pine == "-" else _read_file(args.pine)
    if not pine.strip():
        die("no Pine source given", 1)
    command = {"action": "draw", "pine": pine}
    inputs = parse_inputs(getattr(args, "input", None))
    if inputs is not None:
        command["inputs"] = inputs
    result = send(args, command)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
        extra = error_line(result)
        if extra:
            print(extra)
    return ok_code(result)


def cmd_clear(args) -> int:
    result = send(args, {"action": "clear"})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_remove(args) -> int:
    """Take indicators off the chart — one by name, or every study with --all.

    `clear` deliberately leaves studies the operator or the agent added; this is the door for those.
    The page reports the chart's indicator list before and after, so "removed" is evidence.
    """
    command = {"action": "remove"}
    if getattr(args, "all", False):
        command["all"] = True
    elif getattr(args, "native", ""):
        command["native"] = args.native
    else:
        print("give an indicator name (e.g. macd) or --all", file=sys.stderr)
        return 2
    result = send(args, command)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_script(args) -> int:
    """Drive Script mode: load a .pine into the editor, run what is in it, or read it back."""
    command = {"action": "script", "mode": args.what}
    if getattr(args, "pine", None):
        command["source"] = _read_file(args.pine)
    if args.what == "inputs" and "source" not in command:
        die("script inputs needs --pine FILE (the script whose settings to list)", 2)
    inputs = parse_inputs(getattr(args, "input", None))
    if inputs is not None:
        command["inputs"] = inputs
    result = send(args, command)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_mode(args) -> int:
    """Ask the console to show the chart, or the Pine script mode (the source PineTS is given)."""
    result = send(args, {"action": "mode", "value": args.value})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_browse(args) -> int:
    """Open the Library's concept-family list, narrow it, or read what it is showing.

    Family bubbles expose Library concepts (not indicator scripts); the empty family opens all
    concepts. The separate "Browse all" button in the pane lists indicator scripts.
    """
    payload = {"action": "browse"}
    if args.show:
        payload["show"] = True
    # Always send the selection: an omitted --family means every family, and a stale filter must
    # not survive a call that did not ask for one.
    payload["family"] = args.family or ""
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_open(args) -> int:
    """Open one Library row's detail pane — browsing only, it runs nothing.

    The row is clicked exactly as the operator would click it, so the pane the agent reads is the pane
    the operator sees. Concepts live in the family bubble list; indicator scripts in "Browse all".
    """
    payload = {"action": "open", "slug": args.slug, "kind": args.kind}
    # Always send the family: an omitted --family means "all families", and a filter left over from
    # an earlier call must not silently hide the row this one asked for.
    payload["family"] = args.family or ""
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_reload(args) -> int:
    """Reload the console page — picks up changed frontend files without restarting the app.

    The console's static assets are served `no-store`, so a document reload really does fetch the new
    overlay.js/chart-bridge.js. The page reports the command first, then reloads.
    """
    result = send(args, {"action": "reload", "once_per_view": True})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_apply(args) -> int:
    if args.pine == "-":
        pine = sys.stdin.read()
    else:
        pine = _read_file(args.pine)
    if not pine.strip():
        die("no Pine source given", 1)
    result = send(args, {"action": "apply", "pine": pine})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
        extra = error_line(result)
        if extra:
            print(extra)
    return ok_code(result)


def cmd_add(args) -> int:
    result = send(args, {"action": "add", "native": args.native})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_market(args) -> int:
    result = send(args, {"action": "market", "symbol": args.symbol, "timeframe": args.timeframe})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_layout(args) -> int:
    """Read or change the workspace grid — Vela's own layout presets.

    No preset = read the grid the page is wearing (a read never writes). A preset is `1`, `2h`
    (side by side), `2v` (stacked), `4`, `8`, or a custom grid `g<cols>x<rows>` with 1-4 each.
    The grid is part of the page's own state, so a change made here survives a console reload.
    """
    payload = {"action": "layout"}
    if args.preset:
        payload["layout"] = args.preset
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_natives(args) -> int:
    """What this build can put on the chart from its own side — Vela's natives for this market.

    Read-only. The console's Indicators panel (BUILT-INS) reads the same call, so a name here is a
    name that panel shows.
    """
    result = send(args, {"action": "natives"})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
        if args.list:
            for row in (result.get("catalog") or []):
                marks = []
                if row.get("present"):
                    marks.append("on chart")
                if not row.get("supported", True):
                    marks.append("not on this market")
                if row.get("beta"):
                    marks.append("beta")
                print(f"  {row.get('type', '?'):<24} {row.get('title', ''):<28}"
                      f"{' · '.join(marks)}")
    return ok_code(result)


def cmd_indicators(args) -> int:
    """The Indicators surface: BUILT-INS + LIBRARY + favourites — the DRAWER, opened and read back.

    The ⌗ modal is deleted (3 Oct, the operator's doc §1): the door opens the drawer, sets the
    section/search/family (and optionally a star or a mount), then answers with the rows the list
    actually holds — a drawer that opened is not a drawer that filled.
    """
    payload = {"action": "indicators"}
    if args.close:
        payload["show"] = False
    if args.section:
        payload["section"] = args.section
    # Always send the search text: an omitted --q means "no filter", and a stale one must not
    # survive a call that did not ask for it (same lesson as `browse --family`).
    payload["q"] = args.q or ""
    # Same rule for the family rail: an omitted `--family` means "the whole catalogue", and a filter
    # left over from an earlier call must not silently narrow this one. (`--family all` clears it.)
    payload["family"] = args.family or ""
    if args.star:
        payload["star"] = args.star
    if args.unstar:
        payload["unstar"] = args.unstar
    if args.mount:
        payload["mount"] = args.mount
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
        surface = result.get("indicators") or {}
        if args.list:
            for row in (surface.get("rows") or []):
                marks = []
                if row.get("onChart"):
                    marks.append("on chart")
                if row.get("starred"):
                    marks.append("★")
                print(f"  {row.get('kind', '?'):<8} {row.get('id', ''):<34}"
                      f"{row.get('label', ''):<30}{' · '.join(marks)}")
    return ok_code(result)


def cmd_studies(args) -> int:
    """Everything on the chart, each row labelled with the reader that saw it.

    The five readers are `study` (the console's own chip), `cell` (the workspace cell's on-chart
    rows), `overlay` (a script run through the console's landasan), `paint` (the PineTS paint layer)
    and `native` (Vela's own names). One reader is one blind spot: `state`'s `natives` list is
    Vela's names only, so a script mounted from the Library was invisible to it (26 Sep).
    """
    result = send(args, {"action": "studies"})
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
        if args.list:
            for row in (result.get("studies") or []):
                print(f"  {row.get('source', '?'):<8} {row.get('name', '')}"
                      + (f"  [{', '.join(str(s) for s in (row.get('sources') or []))}]"
                         if len(row.get("sources") or []) > 1 else ""))
            for door in (result.get("doors") or []):
                print(f"  door: {door}")
    return ok_code(result)


def cmd_fullscreen(args) -> int:
    """Give the chart the whole pane — and the whole screen, where the host allows it.

    This presses the same button the console's topbar (and Vela's own toolbar row) carries: the
    console's chrome and panels step aside so the chart owns the page, and the page asks the browser
    for fullscreen so it can take the display too. The answer reports both halves — `native` is worth
    quoting, because a host that refuses fullscreen (a pane iframe without `allowfullscreen`, an
    embedded webview) still gets the chart the page, and that must not read as a failure.
    """
    payload = {"action": "fullscreen", "on": not args.off}
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_theme(args) -> int:
    """Read or set the console's theme — the same switch the ◐ button presses.

    One action moves both systems: our --lx-* palette (the console's own colours), Vela's chrome and
    the chart's parked colours, because the page runs the same `applyTheme` the operator's toggle
    runs. The choice is stored, so it survives a reload. No argument reads what is worn now.
    """
    payload = {"action": "theme"}
    if getattr(args, "value", None):
        payload["theme"] = args.value
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_replay(args) -> int:
    """Drive Vela's own replay engine — the operator's replay button, from the CLI.

    `op` is start / step / play / pause / stop / state. `--bars N` rewinds N bars (default 100),
    `--from MS` an exact epoch-ms start, `--ms` the pace between bars while playing. While replay
    is on, a paper fill uses the replay cursor price — the strip in the chart keeps it in step.
    """
    payload = {"action": "replay", "op": args.op}
    if args.bars is not None:
        payload["bars"] = args.bars
    if args.from_ms:
        payload["from"] = args.from_ms
    if args.ms:
        payload["intervalMs"] = args.ms
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def _edge_text():
    """The same plain-text renderer the MCP tools use (console/mcp/edge_text.py)."""
    here = os.path.dirname(os.path.abspath(__file__))
    sys.path.insert(0, os.path.join(here, "..", "mcp"))      # the repo layout
    sys.path.insert(0, here)                                  # the live tree: sync-live.sh copies it beside the CLI
    import edge_text
    edge_text.use_cli_names()          # the answers point at `trader-chart edge …`, not at MCP tools
    return edge_text


def _edge_params(pairs: list[str]) -> dict:
    out: dict = {}
    for pair in pairs or []:
        key, sep, raw = pair.partition("=")
        if not sep or not key:
            raise SystemExit(f"--param wants name=value, got {pair!r}")
        try:
            out[key] = int(raw) if raw.lstrip("-").isdigit() else float(raw)
        except ValueError:
            out[key] = raw
    return out


def cmd_edge(args) -> int:
    """Edge Stats — LuxAlgo's open-source engine, on this machine: how often did a setup actually work?

    Every answer carries its sample size and a 95% interval; below 10 sessions it prints counts and NO
    rate. `--show` also puts the same answer on the operator's screen. Historical frequencies, not
    predictions. Exit: 0 answered · 1 refused/failed · 2 no console (or, with --show, no chart open).
    """
    txt = _edge_text()
    op = args.edge_op
    api = "/api/edgestats"
    if op == "status":
        data = get(api + "/status")
        text = txt.format_status(data)
    elif op == "presets":
        data = get(api + "/presets")
        text = txt.format_presets(data.get("presets") or [], args.category)
    elif op == "fields":
        data = get(api + "/registry")
        text = txt.format_fields(data.get("entries") or [], args.kind, args.search, args.limit)
    elif op in ("ask", "report"):
        body = {"symbol": args.symbol, "sessionsLimit": args.sessions}
        for key, value in (("since", args.since), ("until", args.until), ("groupBy", args.group), ("sessionKey", args.session)):
            if value:
                body[key] = value
        if op == "ask":
            body["dsl"] = args.query
            data = post(api + "/query", body)
            text = txt.format_result(data, sessions=args.sessions, group_by=args.group)
        else:
            body["presetId"] = args.preset
            params = _edge_params(args.param)
            if params:
                body["params"] = params
            data = post(api + "/preset", body)
            text = txt.format_result(data, sessions=args.sessions, group_by=args.group,
                                     title=f"{(data.get('preset') or {}).get('title') or args.preset} (report)")
        if args.show:
            shown = send(args, {"action": "edge", "op": "ask" if op == "ask" else "report", "symbol": args.symbol,
                                "dsl": getattr(args, "query", ""), "preset": getattr(args, "preset", ""),
                                "params": _edge_params(getattr(args, "param", [])) or None,
                                "since": args.since, "until": args.until, "group_by": args.group})
            text += "\n  on screen: " + (shown.get("detail") or "no detail")
    elif op == "session":
        quoted = urllib.parse.quote(args.session_id, safe="")
        data = get(f"{api}/session?id={quoted}&context=0")
        text = txt.format_session(data)
        if args.show:
            shown = send(args, {"action": "edge", "op": "session", "session": args.session_id})
            text += "\n  on screen: " + (shown.get("detail") or "no detail")
    elif op == "show":
        shown = send(args, {"action": "edge", "op": args.what})
        data = shown
        text = shown.get("detail") or "no detail"
        if args.json:
            print(json.dumps(shown, indent=2, ensure_ascii=False))
            return ok_code(shown)
    elif op == "setup":
        if args.cancel:
            data = post(api + "/cancel", {})
        else:
            body = {k: v for k, v in (("source", args.source), ("symbol", args.symbol), ("years", args.years),
                                      ("archive_only", args.archive_only or None)) if v}
            data = post(api + "/setup", body)
        text = txt.format_job(data)
    else:                                                        # argparse already restricts this
        raise SystemExit(f"unknown edge op {op!r}")
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(text)
    return 0


def _anchor(text: str) -> dict:
    """`bars_ago:price` (e.g. 20:84500) or `time:price` (epoch ms/s or ISO) → one anchor dict."""
    left, sep, price = text.rpartition(":")
    if not sep or not left:
        raise SystemExit(f"anchor {text!r}: write it as BARS_AGO:PRICE (20:84500) or TIME:PRICE (1759000000:84500)")
    try:
        number = float(price)
    except ValueError:
        raise SystemExit(f"anchor {text!r}: the price after the last ':' must be a number")
    if left.isdigit() and int(left) < 100000:
        return {"bars_ago": int(left), "price": number}
    return {"time": int(left) if left.isdigit() else left, "price": number}


def cmd_drawing(args) -> int:
    """Draw with Vela's own tools: add / list / update / remove / clear / types.

    `add trendline 20:84000 0:86500` = a trend line from 20 bars ago at 84000 to the latest bar at
    86500. An anchor is BARS_AGO:PRICE or TIME:PRICE. The count must match the type (op `types`).
    """
    payload = {"action": "drawing", "op": args.op}
    if args.type:
        payload["type"] = args.type
    if args.anchors:
        payload["anchors"] = [_anchor(a) for a in args.anchors]
    if args.id:
        payload["drawing_id"] = args.id    # `id` is reserved by the command queue
    if args.text:
        payload["text"] = args.text
    if args.all:
        payload["all"] = True
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_view(args) -> int:
    """Read or set one view setting; no setting = read them all. `view chart_type heikinashi`."""
    payload = {"action": "view", "setting": args.setting or "state"}
    if args.value is not None:
        payload["value"] = args.value
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_marks(args) -> int:
    """Event marks on the time axis: add / list / remove / clear. `marks add --bars-ago 5 --title FOMC`."""
    payload = {"action": "marks", "op": args.op}
    if args.bars_ago is not None:
        payload["bars_ago"] = args.bars_ago
    for name in ("time", "title", "content", "color", "shape", "letter"):
        val = getattr(args, name)
        if val:
            payload[name] = val
    if args.id:
        payload["mark_id"] = args.id       # `id` is reserved by the command queue
    result = send(args, payload)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def cmd_wait(args) -> int:
    args._payload = {}
    result = wait(args.id, timeout=args.timeout)
    args._payload = result
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("detail") or "no detail")
    return ok_code(result)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="trader-chart", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="print the raw payload")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("state", help="what the live chart is showing")
    s.set_defaults(func=cmd_state)

    s = sub.add_parser("shot", help="capture the chart and save the PNG")
    s.add_argument("--out", help="where to write it (default /tmp/chart-<ts>.png)")
    s.set_defaults(func=cmd_shot)

    s = sub.add_parser("apply", help="run Pine on the chart and paint a matching native")
    s.add_argument("pine", help="a .pine file, or - to read stdin")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("add", help="add a Vela native indicator")
    s.add_argument("native", help="e.g. ema, supertrend, donchian-channels")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("market", help="switch the chart")
    s.add_argument("symbol")
    s.add_argument("timeframe")
    s.set_defaults(func=cmd_market)

    s = sub.add_parser("draw", help="run a Library script and draw its boxes/lines on the overlay")
    s.add_argument("pine", help="a .pine file, or - to read stdin")
    s.add_argument("--input", action="append", metavar="LABEL=VALUE",
                   help="set one of the script's own settings, by label; repeat for more "
                        "(--input Length=50 --input \"Show upper band=false\")")
    s.set_defaults(func=cmd_draw)

    s = sub.add_parser("clear", help="clear the overlay and the natives our paint layer added")
    s.set_defaults(func=cmd_clear)

    s = sub.add_parser("remove", help="take indicators OFF the chart: a name, or --all for every study")
    s.add_argument("native", nargs="?", default="", help="native indicator name, e.g. macd")
    s.add_argument("--all", action="store_true", help="remove every study the chart carries")
    s.set_defaults(func=cmd_remove)

    s = sub.add_parser("script", help="drive Script mode: show / draw / native / clear / inputs, optionally loading a .pine")
    s.add_argument("what", choices=["show", "draw", "native", "clear", "inputs"],
                   help="inputs lists the script's settings (needs --pine) and runs nothing")
    s.add_argument("--pine", help="a .pine file to load into the editor first")
    s.add_argument("--input", action="append", metavar="LABEL=VALUE",
                   help="set one of the script's own settings, by label; repeat for more")
    s.set_defaults(func=cmd_script)

    s = sub.add_parser("browse", help="open the Library concept list, optionally on one family")
    s.add_argument("--show", action="store_true", help="open the panel and concept list, then report the rows")
    s.add_argument("--family", default=None, help="show one concept family slug (trend, smc-ict, …)")
    s.set_defaults(func=cmd_browse)

    s = sub.add_parser("open", help="open one Library row's detail pane (browsing only)")
    s.add_argument("slug", help="the row's slug, e.g. order-blocks")
    s.add_argument("--kind", choices=["concept", "indicator"], default="concept",
                   help="which catalogue the row lives in (default: concept)")
    s.add_argument("--family", default="", help="the concept family to open first (default: all concepts)")
    s.set_defaults(func=cmd_open)

    s = sub.add_parser("mode", help="show the chart, or the Pine script the engine is given")
    s.add_argument("value", choices=["chart", "script"])
    s.set_defaults(func=cmd_mode)

    s = sub.add_parser("reload", help="reload the console page (changed frontend files, no app restart)")
    s.set_defaults(func=cmd_reload)

    s = sub.add_parser("caps", help="what the attached page can execute (from its heartbeat)")
    s.set_defaults(func=cmd_caps)

    s = sub.add_parser("layout", help="read or change the workspace grid (Vela's own presets)")
    s.add_argument("preset", nargs="?", default="",
                   help="1 | 2h | 2v | 4 | 8, or g<cols>x<rows> (1-4 each). Omit to read it.")
    s.set_defaults(func=cmd_layout)

    s = sub.add_parser("studies", help="everything on the chart, with the reader that saw each row")
    s.add_argument("--list", action="store_true", help="print the rows and the cell's removal doors")
    s.set_defaults(func=cmd_studies)
    s = sub.add_parser("natives", help="what this build can put on the chart (Vela's built-ins)")
    s.add_argument("--list", action="store_true", help="print every built-in, not just the count")
    s.set_defaults(func=cmd_natives)

    s = sub.add_parser("indicators", help="open the Indicators surface (built-ins + catalogue + stars)")
    s.add_argument("--section", choices=["favorites", "builtins", "library"], default="",
                   help="which list to show")
    s.add_argument("--q", default=None, help="fill the search box with this")
    s.add_argument("--family", default="",
                   help="narrow the LIBRARY to one family of the catalogue (trend, smc-ict, …); "
                        "pass 'all' to clear it")
    s.add_argument("--star", default="", help="star KIND:ID (native:supertrend, library:order-blocks)")
    s.add_argument("--unstar", default="", help="remove that star")
    s.add_argument("--mount", default="",
                   help="mount a built-in from the surface: native:TYPE (library rows keep the Details pane)")
    s.add_argument("--close", action="store_true", help="close the surface instead")
    s.add_argument("--list", action="store_true", help="print the rows it painted")
    s.set_defaults(func=cmd_indicators)

    s = sub.add_parser("fullscreen", help="give the chart the whole pane / the whole screen (--off to come back)")
    s.add_argument("--off", action="store_true", help="come back to the pane (chrome, panels, statusbar)")
    s.set_defaults(func=cmd_fullscreen)

    s = sub.add_parser("theme", help="read or set the console theme (light | dark)")
    s.add_argument("value", nargs="?", choices=["light", "dark"],
                   help="omit to read what the console is wearing now")
    s.set_defaults(func=cmd_theme)
    s = sub.add_parser("replay", help="drive Vela's replay: start / step / play / pause / stop / state")
    s.add_argument("op", nargs="?", default="state",
                   choices=["start", "step", "play", "pause", "stop", "state"])
    s.add_argument("--bars", type=int, default=None, help="how many bars back `start` rewinds (default 100)")
    s.add_argument("--from", dest="from_ms", type=int, default=0, help="exact epoch-ms start instead of --bars")
    s.add_argument("--ms", type=int, default=0, help="pace between bars while playing (default: last pace)")
    s.set_defaults(func=cmd_replay)

    s = sub.add_parser("drawing", help="draw with Vela's tools: add / list / update / remove / clear / types")
    s.add_argument("op", nargs="?", default="list",
                   choices=["add", "list", "update", "remove", "clear", "types"])
    s.add_argument("type", nargs="?", default="", help="(add) a Vela type or plain word: trendline, fib, channel …")
    s.add_argument("anchors", nargs="*", help="(add) BARS_AGO:PRICE or TIME:PRICE, one per anchor")
    s.add_argument("--id", default="", help="(update / remove) which drawing — `list` shows the ids")
    s.add_argument("--text", default="", help="(add / update) the drawing's text")
    s.add_argument("--all", action="store_true", help="(clear) confirm removing EVERY drawing, hand-drawn too")
    s.set_defaults(func=cmd_drawing)

    s = sub.add_parser("view", help="read or set a view setting (chart_type, timezone, log, watermark …)")
    s.add_argument("setting", nargs="?", default="", help="omit to read everything")
    s.add_argument("value", nargs="?", default=None, help="omit to read just this one")
    s.set_defaults(func=cmd_view)

    s = sub.add_parser("marks", help="event marks on the time axis: add / list / remove / clear")
    s.add_argument("op", nargs="?", default="list", choices=["add", "list", "remove", "clear"])
    s.add_argument("--bars-ago", dest="bars_ago", type=int, default=None, help="0 = the latest bar")
    s.add_argument("--time", default="", help="exact epoch ms / seconds / ISO instead of --bars-ago")
    s.add_argument("--title", default="")
    s.add_argument("--content", default="", help="the text shown on hover")
    s.add_argument("--color", default="", help="hex like #f5a623")
    s.add_argument("--shape", default="", choices=["", "circle", "square", "diamond", "pin"])
    s.add_argument("--letter", default="", help="up to 2 characters on the glyph")
    s.add_argument("--id", default="", help="(remove) which mark")
    s.set_defaults(func=cmd_marks)

    s = sub.add_parser("edge", help="Edge Stats: how often did a setup actually work? (N + 95%% interval on every number)")
    es = s.add_subparsers(dest="edge_op", required=True)

    def _edge_common(sp, with_show=True):
        sp.add_argument("--symbol", default="", help="a symbol the store holds (see `edge status`)")
        sp.add_argument("--since", default="", help="ISO date lower bound")
        sp.add_argument("--until", default="", help="ISO date upper bound")
        sp.add_argument("--group", default="", help="split by a categorical field (dayOfWeek, month, gapBucket …)")
        sp.add_argument("--session", default="", help="session window (rth, utc, london …)")
        sp.add_argument("--sessions", type=int, default=8, help="matching sessions to list (default 8)")
        if with_show:
            sp.add_argument("--show", action="store_true", help="also put the answer on the operator's screen")
        sp.add_argument("--json", action="store_true", help="print the raw envelope")

    e = es.add_parser("status", help="installed? what data? a download running?")
    e.add_argument("--json", action="store_true")
    e = es.add_parser("presets", help="the 42-report catalogue")
    e.add_argument("--category", default="")
    e.add_argument("--json", action="store_true")
    e = es.add_parser("fields", help="the query language's vocabulary")
    e.add_argument("--kind", default="", choices=["", "outcome", "predicate", "field"])
    e.add_argument("--search", default="")
    e.add_argument("--limit", type=int, default=40)
    e.add_argument("--json", action="store_true")
    e = es.add_parser("ask", help="P(outcome | conditions): edge ask \"gapFill WHERE dayOfWeek = Tue\" --symbol BTCUSDT")
    e.add_argument("query", help="OUTCOME [WHERE condition [AND condition …]]")
    _edge_common(e)
    e = es.add_parser("report", help="run one catalogue report: edge report orb --symbol BTCUSDT --param window=30")
    e.add_argument("preset")
    e.add_argument("--param", action="append", default=[], help="name=value (repeatable)")
    _edge_common(e)
    e = es.add_parser("session", help="one session: levels and event times (SYMBOL|session|DATE)")
    e.add_argument("session_id")
    e.add_argument("--show", action="store_true", help="also show its chart on screen")
    e.add_argument("--json", action="store_true")
    e = es.add_parser("show", help="open / close the Edge Stats sheet on the operator's screen")
    e.add_argument("what", nargs="?", default="open", choices=["open", "data", "close", "state"])
    e.add_argument("--json", action="store_true")
    e = es.add_parser("setup", help="load demo data or download free history (background job)")
    e.add_argument("--source", default="", choices=["", "demo", "binance", "dukascopy"])
    e.add_argument("--symbol", default="")
    e.add_argument("--years", type=float, default=0)
    e.add_argument("--archive-only", dest="archive_only", action="store_true")
    e.add_argument("--cancel", action="store_true")
    e.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_edge)

    s = sub.add_parser("wait", help="wait for an earlier command's outcome")
    s.add_argument("id", type=int)
    s.add_argument("--timeout", type=float, default=TIMEOUT)
    s.set_defaults(func=cmd_wait)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
