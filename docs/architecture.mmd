%% Trader's Agent — what the system is right now (18/19 Sep 2026)
%% Renders at https://mermaid.live , in GitHub markdown, and inside docs/architecture.html
flowchart TB
  subgraph SURFACE["Hermes Desktop — the operator's window"]
    direction TB
    ROW["Sidebar row · Trader's Agent<br/><i>sidebar.nav</i>"]
    ROUTE["Route /trading-desk<br/>reveals the pane + opens the desk chat"]
    PANE["Pane traders-desk:chart<br/>iframe → 127.0.0.1:8787/?v=stamp<br/>remounts when revealed again"]
    CHIP["Status chip"]
    PAL["Palette: open console · reload chart pane"]
    CHAT["Desk chat — a real Hermes session<br/>reads and drives the chart"]
  end

  subgraph CONSOLE["Local console · 127.0.0.1:8787 · systemd user unit"]
    API["HTTP API · server.py<br/>static page + /api/chart/* + /api/build"]
    HUB["SSE push hub · chart_stream.py<br/>attach · publish · claim · keepalive 8s"]
    FILES[("File bridge · agents/_chart/<br/>commands.json · results.json · state.json")]
    PAGE["Console page · frontend/<br/>boot · run · claim · heartbeat"]
    VELA["Vela chart + workspace shell<br/>its rendererConfig is the colours"]
    PINETS["PineTS engine"]
    DATA["Binance public data"]
  end

  subgraph AGENTS["Agent side"]
    ME["Hermes agent (this chat)"]
    CLI["CLI · bin/trader-chart<br/>state · shot · apply · add<br/>market · draw · reload · caps"]
    MCP["MCP · traders-chart<br/>7 native chart tools"]
    LUX["LuxAlgo MCP<br/>library · edge · prop-firm"]
  end

  REPO["Private repo · tradersagent-plugin<br/>install.sh → desktop-plugins/traders-desk"]

  ROW --> ROUTE
  ROUTE --> PANE
  ROUTE --> CHAT
  PAL --> PANE
  CHIP --> ROUTE

  ME --> CLI
  ME --> MCP
  CHAT --> MCP
  CLI -->|"POST /api/chart/command"| API
  MCP -->|"same API"| API

  API --> HUB
  API --- FILES
  HUB -->|"SSE push · add ~37 ms · shot ~70 ms"| PAGE
  PAGE -->|"POST /api/chart/result (inline wait)"| API
  PAGE -->|"heartbeat 4s · symbol tf bars natives build viewer"| API
  PAGE -->|"POST /api/chart/claim · one console executes"| API
  PANE -.->|"iframe load · no-store"| PAGE

  PAGE --- VELA
  PAGE --- PINETS
  VELA --> DATA
  API -->|"library · edge · prop-firm"| LUX
  REPO -.->|"deploy"| SURFACE

  classDef ui fill:#08334466,stroke:#22d3ee,color:#e2e8f0
  classDef back fill:#064e3b66,stroke:#34d399,color:#e2e8f0
  classDef data fill:#4c1d9566,stroke:#a78bfa,color:#e2e8f0
  classDef ext fill:#78350f4d,stroke:#fbbf24,color:#e2e8f0
  classDef slate fill:#1e293b80,stroke:#94a3b8,color:#e2e8f0

  class ROW,ROUTE,PANE,CHIP,PAL,CHAT ui
  class API,HUB,PAGE back
  class FILES data
  class VELA,PINETS,DATA,LUX ext
  class ME,CLI,MCP,REPO slate
