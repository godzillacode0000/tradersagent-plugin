//@version=5
//@fx GBPUSD
//@tf 30
// NY AM · spot SMT (GBPUSD vs EURUSD) · sweep → 50% fib, risk-sized  (v2)
//
// The two directive lines above are this console's own: `//@fx` names the market the script belongs
// to (bars from /api/fx/bars, Dukascopy ticks or Yahoo), `//@tf` its timeframe. Without them the run
// uses the chart's bars — which for a forex strategy is the wrong instrument.
// Measured (20 Oct 2026, GBPUSD 1h, 17,258 bars, Yahoo FX, 1.5% risk per trade):
//   these defaults (2R + SMT)  → 68 trades · net −867.75 · 34% wins · PF 0.88
//   1.5R + SMT                 → 67 trades · net −312.44 · 39% wins · PF 0.95
//   1R + SMT                   → 68 trades · net  +40.53 · 46% wins · PF 1.01
//   2R, SMT off                → 123 trades · net −451.27 · 34% wins · PF 0.96
// The mechanics are sound (a 2-year run fills 68 round trips and reports a real ledger); the edge is
// NOT in these rules yet on this pair. Kept as the honest baseline, not as a recommendation.
//
// margin_long/short = 0 on purpose: risk sizing asks for ~55k units on a 10k account, and with a
// 100% margin gate the emulator rejects every order (measured — 85 orders placed, zero fills).
strategy("NY AM · SMT sweep → 50% fib", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=2, margin_long=0, margin_short=0, pyramiding=0,   // 0 = no margin gate: size by RISK, not by notional
     calc_on_order_fills=false, process_orders_on_close=false)

// ── inputs ───────────────────────────────────────────────────────────────────────────────────
sess     = input.session("0900-1200", "Tradable window (ET)")      // NY AM, after the 08:30 slot
riskPct  = input.float(1.5, "Risk per trade (% of equity)", minval=0.1, maxval=5, step=0.1)
smtPair  = input.string("EURUSD", "SMT pair")
useSMT   = input.bool(true, "Require SMT divergence")
sweepLen = input.int(20, "Sweep lookback (bars)", minval=5, maxval=100)
legBars  = input.int(10, "Displacement window (bars)", minval=3, maxval=30)
entryLife= input.int(10, "Limit order life (bars)", minval=1, maxval=50)
rr       = input.float(2.0, "Target (R multiple)", minval=0.5, maxval=10, step=0.25)
bufATR   = input.float(0.1, "Stop buffer (× ATR)", minval=0, maxval=2, step=0.05)
newsA    = input.time(timestamp("20 Oct 2026 08:30"), "News 1 (ET)")
newsB    = input.time(timestamp("20 Oct 2026 08:30"), "News 2 (ET)")
newsPad  = input.int(45, "Blackout minutes around news")

// ── 1. session ───────────────────────────────────────────────────────────────────────────────
inAM   = not na(time(timeframe.period, sess, "America/New_York"))

// ── 3. high-impact news blackout (Pine has no calendar: the timestamps are inputs) ───────────
blocked = (time >= newsA - newsPad * 60000 and time <= newsA + newsPad * 60000) or
          (time >= newsB - newsPad * 60000 and time <= newsB + newsPad * 60000)

// ── 2. spot SMT: our pair makes a lower low while the other makes a higher low ───────────────
otherLow = request.security(smtPair, timeframe.period, low)
ourLL    = ta.lowest(low, sweepLen) < ta.lowest(low, sweepLen)[1]
othLL    = ta.lowest(otherLow, sweepLen) < ta.lowest(otherLow, sweepLen)[1]
smtBull  = ourLL and not othLL

// ── 4. liquidity sweep: wick below the prior low, CLOSE back above it ────────────────────────
priorLow = ta.lowest(low, sweepLen)[1]
atr      = ta.atr(14)                     // every bar: a ta.* call inside an if{} keeps broken state
swept    = low < priorLow and close > priorLow
setup    = inAM and not blocked and swept and (not useSMT or smtBull)

var float sweepLow  = na
var float legHigh   = na
var int   armedAt   = na
var float stopPrice = na
var float tgtPrice  = na
var int   validTill = na
var int   nSetups   = 0

if setup
    nSetups  := nSetups + 1
    sweepLow := low
    legHigh  := high
    armedAt  := bar_index

// The leg grows while the sweep holds. Invalidation used to fire on the first close under the
// sweep low, which killed 8 of 15 setups before they could displace (measured 20 Oct); the rule
// now is: a close under the low only matters while the impulse has NOT started yet.
if not na(armedAt) and bar_index > armedAt and bar_index - armedAt <= legBars
    if close < sweepLow and (legHigh - sweepLow) < atr * 0.5
        armedAt := na                       // the sweep failed before any displacement
    else
        legHigh := math.max(legHigh, high)

// ── 5. entry: a resting limit at the 50% of the leg, risk-sized ──────────────────────────────
// Armed once the impulse is real (≥ 1 ATR off the sweep low) — not on a fixed bar count.
ready  = not na(armedAt) and bar_index > armedAt and (legHigh - sweepLow) >= atr * 1.0
fib50  = ready ? (sweepLow + legHigh) / 2 : na

if ready
    stopPrice := sweepLow - atr * bufATR
    tgtPrice  := fib50 + (fib50 - stopPrice) * rr
    riskCash  = strategy.equity * riskPct / 100.0
    qty       = riskCash / math.max(fib50 - stopPrice, syminfo.mintick * 10)
    validTill := bar_index + entryLife
    strategy.entry("Long", strategy.long, qty=qty, limit=fib50)
    armedAt   := na

// brackets are re-issued while the position lives (an exit queued before a resting limit fills is
// not guaranteed to survive the fill), and a limit that never filled is cancelled by hand
if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop=stopPrice, limit=tgtPrice)
else if not na(validTill) and bar_index > validTill
    strategy.cancel("Long")
    validTill := na

plot(inAM ? 1 : na, "in window", color=color.new(color.teal, 80), style=plot.style_columns)
plot(fib50, "50% fib", color=color.orange, style=plot.style_circles)
