# runtime state — chart bridge files, study threads, screenshots
console/agents/
# LuxAlgo's builds live under vendor/{vela,vela-pinets}/ and ARE redistributed here (see
# THIRD-PARTY.md — Vela Apache-2.0, vela-pinets AGPL-3.0). These two patterns only catch stray files
# dropped directly into vendor/, not those directories.
console/frontend/vendor/*.js
console/frontend/vendor/*.css
# …but the pinets engine IS redistributed: a PATCHED build from the fork below (see vendor/pinets/PROVENANCE.md).
!console/frontend/vendor/pinets/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# local scratch
*.log
/tmp/
# local test screenshots (grim captures from UI verification runs)
/shots/
docs/shots/

# PR Lens writes its previews here. They are rebuilt on demand.
.pr-lens/
